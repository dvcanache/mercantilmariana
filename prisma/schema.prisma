generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES_CLERK
}

enum PaymentMethod {
  DIVISAS_EFECTIVO
  PUNTO_VENTA_BS
  PAGO_MOVIL
  ZELLE
  TRANSFERENCIA
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         UserRole           @default(SALES_CLERK)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sales        SaleTransaction[]

  @@index([role, active])
}

model ExchangeRateSetting {
  id                      String   @id @default(cuid())
  supplierReplacementRate Decimal  @db.Decimal(12, 4) // Tasa Compra Variante (Bs/$)
  officialBcvRate         Decimal  @db.Decimal(12, 4) // Tasa Venta BCV (Bs/$)
  promoDiscountPercentage Decimal  @default(0.06) @db.Decimal(5, 4) // 6% default
  updatedAt               DateTime @updatedAt
}

model RateHistory {
  id                      String   @id @default(cuid())
  officialBcvRate         Decimal  @db.Decimal(12, 4)
  supplierReplacementRate Decimal  @db.Decimal(12, 4)
  source                  String   @default("MANUAL") // AUTO_SYNC, MANUAL_OVERRIDE
  timestamp               DateTime @default(now())
}

model Category {
  id              String    @id @default(cuid())
  code            String    @unique // CAT-01, CAT-02...
  name            String
  suggestedMargin Decimal   @default(0.35) @db.Decimal(5, 4)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

model Product {
  id                     String            @id @default(cuid())
  sku                    String            @unique // PROD-001...
  name                   String
  categoryId             String
  category               Category          @relation(fields: [categoryId], references: [id])
  brand                  String
  model                  String
  supplierCostUsd        Decimal           @db.Decimal(10, 2) // Costo Proveedor ($)
  targetMarginPercentage Decimal           @default(0.35) @db.Decimal(5, 4) // Margen de contribución
  unitOfMeasure          String            @default("Unidad")
  currentStock           Decimal           @default(0) @db.Decimal(10, 2)
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  sales                  SaleTransaction[]
}

model SaleTransaction {
  id               String        @id @default(cuid())
  date             DateTime      @default(now())
  paymentMethod    PaymentMethod
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  invoiceNumber    String?
  quantity         Decimal       @db.Decimal(10, 2)
  unitSalePriceUsd Decimal       @db.Decimal(10, 2)
  unitCostUsd      Decimal       @db.Decimal(10, 2)
  totalSaleUsd     Decimal       @db.Decimal(10, 2)
  unitMarginUsd    Decimal       @db.Decimal(10, 2)
  totalMarginUsd   Decimal       @db.Decimal(10, 2)
  recordedById     String?
  recordedBy       User?         @relation(fields: [recordedById], references: [id])
  createdAt        DateTime      @default(now())
}

model FixedCostItem {
  id               String   @id @default(cuid())
  concept          String
  monthlyAmountUsd Decimal  @db.Decimal(10, 2)
  active           Boolean  @default(true)
  orderIndex       Int      @default(0)
  updatedAt        DateTime @updatedAt
}
